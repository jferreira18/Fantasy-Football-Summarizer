[Unit]
Description=Fantasy League Intelligence Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fantasy
WorkingDirectory=/opt/fantasy-agent
ExecStart=/opt/fantasy-agent/.venv/bin/python -m src.jobs.scheduler
Restart=on-failure
RestartSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
